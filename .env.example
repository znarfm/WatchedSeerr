# Cron Endpoint Security Secret
# create one using `openssl rand -hex 24`
CRON_SECRET="change-this-to-a-secure-random-token"

# Inactivity & Conflict Thresholds (days)
GHOST_THRESHOLD_DAYS=30
CONFLICT_THRESHOLD_DAYS=60
